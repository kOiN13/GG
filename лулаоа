def encrypt(text):
    text = text.replace(" ", "").upper()

    magic = [
        [8, 1, 6],
        [3, 5, 7],
        [4, 9, 2]
    ]

    remainder = len(text) % 9

    if remainder != 0:
        missing = 9 - remainder
        print(f"Не хватает символов: {missing}")
        extra = input(f"Введите ещё {missing} символ(ов): ")
        text += extra.replace(" ", "").upper()

    if len(text) % 9 != 0:
        print("Ошибка: количество символов должно быть кратно 9.")
        return ""

    result = ""

    for start in range(0, len(text), 9):
        block = text[start:start + 9]

        positions = list(range(9))
        positions.sort(
            key=lambda i: magic[i // 3][i % 3]
        )

        for i in positions:
            result += block[i]

    return result


message = input("Введите исходный текст: ")
encrypted = encrypt(message)

if encrypted:
    print("Зашифрованный текст:", encrypted)