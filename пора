
class Musician:
    def __init__(self, name, instrument, experience):
        self.name = name
        self.__instrument = instrument
        self.__experience = experience

    @property
    def instrument(self):
        return self.__instrument

    @instrument.setter
    def instrument(self, value):
        if not isinstance(value, str) or not value.strip():
            raise ValueError("Инструмент должен быть непустой строкой!")
        self.__instrument = value

    @property
    def experience(self):
        return self.__experience

    @experience.setter
    def experience(self, value):
        if not isinstance(value, int) or isinstance(value, bool) or value < 0:
            raise ValueError("Опыт должен быть целым числом >= 0!")
        self.__experience = value

    def display_info(self):
        print(f"Имя: {self.name}")
        print(f"Инструмент: {self.instrument}")
        print(f"Опыт: {self.experience} лет")

    def practice(self):
        print(f"{self.name} играет на инструменте: {self.instrument}")

    def __del__(self):
        print(f"Объект музыканта {self.name} удалён.")


class RockMusician(Musician):
    def __init__(self, name, instrument, experience, band):
        super().__init__(name, instrument, experience)
        self.band = band

    def display_info(self):
        super().display_info()
        print(f"Группа: {self.band}")

    def practice(self):
        print(f"{self.name} репетирует рок-музыку "
              f"в группе {self.band}.")


def main():
    print("=== Исходный класс Musician ===")
    musician = Musician("Иван", "гитара", 3)
    musician.display_info()
    musician.practice()

    print("\n=== Работа свойств ===")
    musician.experience = 5
    musician.instrument = "бас-гитара"
    musician.display_info()

    print("\n=== Проверка некорректных значений ===")
    try:
        musician.experience = -2
    except ValueError as error:
        print("Ошибка:", error)

    try:
        musician.instrument = ""
    except ValueError as error:
        print("Ошибка:", error)

    print("\n=== Прямой доступ к приватному атрибуту ===")
    try:
        print(musician.__experience)
    except AttributeError:
        print("Ошибка: прямой доступ к __experience невозможен!")

    print("\n=== Подкласс RockMusician ===")
    rock_musician = RockMusician(
        "Алексей", "электрогитара", 7, "Thunder"
    )
    rock_musician.display_info()
    rock_musician.practice()

    print("\n=== Полиморфизм ===")
    musicians = [musician, rock_musician]

    for item in musicians:
        item.display_info()
        item.practice()
        print("-" * 30)


if __name__ == "__main__":
    main()
