def create_magic_square(n):
    square = [[0] * n for _ in range(n)]

    i = 0
    j = n // 2

    for num in range(1, n * n + 1):
        square[i][j] = num

        new_i = (i - 1) % n
        new_j = (j + 1) % n

        if square[new_i][new_j] != 0:
            i = (i + 1) % n
        else:
            i = new_i
            j = new_j

    return square


def encrypt(text, n):
    text = text.replace(" ", "").upper()

    magic = create_magic_square(n)
    block_size = n * n

    remainder = len(text) % block_size

    if remainder != 0:
        missing = block_size - remainder
        print(f"Не хватает символов: {missing}")
        extra = input(f"Введите ещё {missing} символ(ов): ")
        text += extra.replace(" ", "").upper()

    if len(text) % block_size != 0:
        print("Ошибка: количество символов должно быть кратно размеру квадрата.")
        return ""

    result = ""

    positions = list(range(block_size))
    positions.sort(
        key=lambda i: magic[i // n][i % n]
    )

    for start in range(0, len(text), block_size):
        block = text[start:start + block_size]

        for i in positions:
            result += block[i]

    return result


print("Выберите размер магического квадрата.")
print("Размер должен быть нечётным числом: 3, 5, 7, 9...")

n = int(input("Введите размер квадрата: "))

if n < 3 or n % 2 == 0:
    print("Ошибка! Введите нечётное число не меньше 3.")
else:
    message = input("Введите исходный текст: ")

    encrypted = encrypt(message, n)

    if encrypted:
        print("Зашифрованный текст:", encrypted)