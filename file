
def create_table(rows, cols):
    table = []
    number = 1

    for i in range(rows):
        row = []
        for j in range(cols):
            row.append(number)
            number += 1
        table.append(row)

    return table


def encrypt(text, rows, cols):
    text = text.replace(" ", "").upper()

    table = create_table(rows, cols)
    block_size = rows * cols

    remainder = len(text) % block_size

    if remainder != 0:
        missing = block_size - remainder
        print(f"Не хватает символов: {missing}")
        extra = input(f"Введите ещё {missing} символ(ов): ")
        text += extra.replace(" ", "").upper()

    if len(text) % block_size != 0:
        print("Ошибка: количество символов не подходит.")
        return ""

    positions = []

    for i in range(rows):
        for j in range(cols):
            positions.append((i, j))

    # Сортировка по номерам таблицы
    positions.sort(key=lambda pos: table[pos[0]][pos[1]])

    result = ""

    for start in range(0, len(text), block_size):
        block = text[start:start + block_size]

        for i, j in positions:
            result += block[i * cols + j]

    return result


print("Шифрование методом перестановки")

rows = int(input("Введите количество строк: "))
cols = int(input("Введите количество столбцов: "))

if rows < 1 or cols < 1:
    print("Ошибка! Размеры должны быть положительными.")
else:
    message = input("Введите исходный текст: ")

    encrypted = encrypt(message, rows, cols)

    if encrypted:
        print("Зашифрованный текст:", encrypted)
